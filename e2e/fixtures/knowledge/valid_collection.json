      "disease_name": "流行性感冒",
      "aliases": ["甲流", "乙流", "流感", "流行性感冒病毒感染"],
      "department": "呼吸内科",
      "secondary_departments": ["发热门诊", "感染科", "急诊科"],
      "target_population": ["adult", "elderly", "child", "pregnant"],
      "section_type": "clinical_manifestation",
      "content": "起病急，主要表现为高热（体温可达39~40℃）、畏寒、寒战、头痛、全身肌肉关节酸痛、极度乏力、食欲减退等全身症状，常有咽喉痛、干咳，可有鼻塞、流涕、胸骨后不适。无并发症者病程呈自限性，多于发病3~4天后体温逐渐消退。",
      "key_symptoms": ["高热", "全身肌肉酸痛", "乏力", "咽痛", "干咳", "寒战"],
      "differential_points": [
        "普通感冒以鼻塞流涕等局部卡他症状为主，全身酸痛和持续高热相对较轻",
        "若持续高热超3天伴呼吸急促、胸闷或血氧下降，需警惕病毒性肺炎"
      ],
      "red_flag_signs": ["呼吸困难", "持续高热超过3天不退", "意识模糊", "口唇发绀", "剧烈胸痛"],
      "seasonal_tags": ["winter", "spring", "influenza_season"],
      "suggested_follow_up_slots": [
        {
          "slot_key": "onset_duration",
          "short_question": "发烧大概持续多久了？",
          "quick_options": ["今天刚开始", "2~3天", "超过3天"]
        },
        {
          "slot_key": "contact_history",
          "short_question": "身边近期有人发烧或感冒吗？",
          "quick_options": ["有家人/同事发烧", "没有明确接触", "不太清楚"]
        }
      ],
      "updated_at": "2026-11-18T00:00:00Z"
    },
