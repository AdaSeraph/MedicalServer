# MedicalServer Cloud Production Environment Template
# Copy to deploy/.env and replace all secrets before production deployment

SERVER_ADDR=0.0.0.0:8080
RUST_LOG=info

# Set false when PostgreSQL / Redis / Qdrant are connected; true for standalone in-memory mode
MEDICAL_R5_OFFLINE=false

# Infrastructure URLs
DATABASE_URL=postgres://medical:medical_secret@127.0.0.1:5432/medical_server
REDIS_URL=redis://127.0.0.1:6379
QDRANT_URL=http://127.0.0.1:6334

# Security & Encryption (MUST replace in production!)
JWT_SECRET=replace-with-high-entropy-jwt-secret
JWT_TTL_SECS=7200
PATIENT_ID_SALT=replace-with-hospital-unique-salt
FIELD_ENCRYPTION_KEY=replace-with-64-hex-chars-or-32-byte-base64-aes256-key
MEDICAL_ADMIN_TOKEN=replace-with-admin-bearer-token

# WeChat Mini Program (optional; leave empty for offline/dev auth)
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Upstream LLM / Embedding / Rerank (OpenAI-compatible cloud or intranet vLLM/Ollama)
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-replace-me
OPENAI_FAST_MODEL=deepseek-chat
OPENAI_REASONING_MODEL=deepseek-chat
EMBEDDING_BASE_URL=
RERANK_BASE_URL=
