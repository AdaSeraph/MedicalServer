[Unit]
Description=MedicalServer High-Concurrency AI Triage & Knowledge Service
After=network-online.target postgresql.service redis.service
Wants=network-online.target

[Service]
Type=simple
User=medical
Group=medical
WorkingDirectory=/opt/medical-server
Environment=MEDICAL_DATA_DIR=/opt/medical-server/data
Environment=TANTIVY_INDEX_DIR=/opt/medical-server/data/tantivy
EnvironmentFile=/opt/medical-server/.env
ExecStart=/opt/medical-server/medical-server
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/medical-server/data

[Install]
WantedBy=multi-user.target
