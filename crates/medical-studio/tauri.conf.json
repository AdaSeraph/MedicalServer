{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MedicalStudio",
  "version": "0.1.0",
  "identifier": "com.medicalserver.studio",
  "build": {
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MedicalStudio — 智能医疗分诊与知识库工作台",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
