.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #e2e8f0;
}

.top-title {
  display: flex;
  flex-direction: column;
}

.title-main {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.title-sub {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.memory-entry-btn {
  margin: 0;
  padding: 0 24rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  background-color: #f0fdfa;
  color: #0f766e;
  border: 1rpx solid #99f6e4;
  border-radius: 30rpx;
}

.chat-list {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

.msg-row {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.msg-right {
  align-items: flex-end;
}

.msg-left {
  align-items: flex-start;
}

.bubble {
  max-width: 80%;
  padding: 20rpx 26rpx;
  border-radius: 20rpx;
  line-height: 1.5;
}

.bubble-user {
  background-color: #0f766e;
  color: #ffffff;
}

.bubble-bot {
  background-color: #ffffff;
  color: #1e293b;
  border: 1rpx solid #e2e8f0;
}

.triage-card {
  margin-top: 16rpx;
  width: 92%;
  border-left: 8rpx solid #0f766e;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.dept-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f766e;
}

.urgency-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background-color: #fef3c7;
  color: #b45309;
  font-weight: 600;
}

.urgency-l1 {
  background-color: #fee2e2;
  color: #b91c1c;
}

.urgency-l2 {
  background-color: #ffedd5;
  color: #c2410c;
}

.urgency-l3 {
  background-color: #fef3c7;
  color: #b45309;
}

.urgency-l4 {
  background-color: #ccfbf1;
  color: #0f766e;
}

.secondary-depts {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #475569;
  margin-bottom: 12rpx;
}

.secondary-label {
  color: #64748b;
}

.secondary-pill {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background-color: #f1f5f9;
  color: #334155;
  font-size: 22rpx;
}

.card-summary {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.reg-btn {
  margin-top: 18rpx;
}

.quick-options-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 16rpx 24rpx;
  background-color: #f8fafc;
  border-top: 1rpx solid #e2e8f0;
}

.quick-opt-btn {
  margin: 0;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  background-color: #ffffff;
  color: #0f766e;
  border: 1rpx solid #0f766e;
  border-radius: 999rpx;
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top: 1rpx solid #e2e8f0;
}

.chat-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  background-color: #f1f5f9;
  border-radius: 38rpx;
  font-size: 28rpx;
}

.send-btn {
  margin: 0;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 32rpx;
  background-color: #0f766e;
  color: #ffffff;
  border-radius: 38rpx;
  font-size: 28rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(15, 23, 42, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-box {
  width: 86%;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 20rpx;
}

.modal-body {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.6;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.consent-check-row {
  display: flex;
  align-items: center;
  margin: 24rpx 0;
  font-size: 24rpx;
  color: #0f766e;
}

.emergency-box {
  border: 4rpx solid #dc2626;
}

.emergency-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #dc2626;
  margin-bottom: 18rpx;
}

.emergency-body {
  font-size: 28rpx;
  color: #7f1d1d;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.dial-120-btn {
  margin-top: 24rpx;
}

.close-emergency-btn {
  margin-top: 16rpx;
  background-color: #f1f5f9;
  color: #475569;
  font-size: 26rpx;
}
