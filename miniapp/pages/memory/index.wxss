.memory-page {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 18rpx;
}

.consent-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
}

.pid-label {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #64748b;
  word-break: break-all;
}

.field-row {
  display: flex;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.label {
  color: #64748b;
  width: 150rpx;
}

.allergy-text {
  color: #dc2626;
  font-weight: 600;
}

.event-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.event-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.event-dept {
  font-weight: 600;
  color: #0f766e;
}

.event-date {
  font-size: 22rpx;
  color: #94a3b8;
}

.event-cc {
  font-size: 26rpx;
  color: #1e293b;
}

.event-summary {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.empty-box {
  text-align: center;
  color: #64748b;
}

.wipe-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #64748b;
  text-align: center;
  line-height: 1.5;
}
