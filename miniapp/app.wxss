page {
  background-color: #f4f7f9;
  color: #1e293b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
}

.card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
}

.disclaimer-box {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.5;
  padding: 16rpx 20rpx;
  background-color: #f1f5f9;
  border-radius: 12rpx;
}

.btn-primary {
  background-color: #0f766e;
  color: #ffffff;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-danger {
  background-color: #dc2626;
  color: #ffffff;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}
